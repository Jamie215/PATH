---
import Base from '../../layouts/Base.astro';
import { assessmentBySlug } from '../../assessments/registry';
import FreBAQSurvey from '../../components/FreBAQSurvey.svelte';
import BackLink from '../../components/BackLink.svelte';

const { title } = assessmentBySlug('frebaq');
---
<Base title={`${title} · Survey`} description={`${title} — survey`} wide>
  <BackLink client:only="svelte" />
  <h1 class="survey-heading">{title}</h1>
  <FreBAQSurvey client:only="svelte" />
</Base>

<style>
  .survey-heading {
    margin-bottom: var(--space-3);
  }
</style>
