---
import Base from '../../layouts/Base.astro';
import { assessmentBySlug } from '../../assessments/registry';
import MSISurvey from '../../components/MSISurvey.svelte';
import BackLink from '../../components/BackLink.svelte';
import { assessmentUrl } from '../../lib/routes';

const { title } = assessmentBySlug('msi');
---
<Base title={`${title} · Survey`} description={`${title} — survey`} wide>
  <BackLink href={assessmentUrl('msi')} />
  <h1 class="survey-heading">{title}</h1>
  <MSISurvey requireRole client:only="svelte" />
</Base>

<style>
  .survey-heading {
    margin-bottom: var(--space-3);
  }
</style>
